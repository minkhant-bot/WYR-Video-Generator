# Would You Rather single-user generator
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional path for the server-side Settings UI credential file.
# Environment API keys above take precedence over values stored there.
# WYR_SECRET_CONFIG_PATH=.wyr-secrets.json

# Optional local tuning
WYR_PORT=3100
WYR_JOBS_DIR=data/wyr-jobs
WYR_QUESTION_COUNT=6
WYR_CONTENT_GENERATION_RETRIES=4
WYR_GROQ_RATE_LIMIT_RETRIES=4
WYR_GROQ_RATE_LIMIT_MAX_WAIT_MS=60000
# Mount a Railway persistent volume and point this directory into it to retain
# duplicate/category history across deployments, e.g. /data/wyr-content-history.
WYR_CONTENT_HISTORY_DIR=data/content-history
WYR_SECONDS_PER_QUESTION=7
WYR_VOICE_PADDING_SECONDS=1.5
WYR_MAX_IMAGE_SEARCH_RETRIES=2
WYR_PEXELS_CONCURRENCY=4
# Web images are disabled by default. Set WYR_ALLOW_WEB_IMAGES=1 only to show
# clearly marked DuckDuckGo candidates without treating them as licensed.
WYR_ALLOW_WEB_IMAGES=0
WYR_TTS_CONCURRENCY=4
WYR_SCENE_RENDER_CONCURRENCY=2
WYR_FFMPEG_THREADS=4
WYR_REQUEST_TIMEOUT_MS=20000
WYR_TTS_TIMEOUT_MS=60000
WYR_EDGE_VOICE=en-US-AndrewNeural
WYR_EDGE_VOICE_RATE=-10%

# Optional executable/font overrides. Relative paths resolve from this project.
# FFMPEG_PATH=
# FFPROBE_PATH=
# WYR_FONT_PATH=assets/fonts/FreeSansBold.ttf
