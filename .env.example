# Would You Rather single-user generator
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PEXELS_API_KEY=

# Optional local tuning
WYR_PORT=3100
WYR_JOBS_DIR=data/wyr-jobs
WYR_QUESTION_COUNT=8
WYR_SECONDS_PER_QUESTION=7
WYR_MAX_SCENE_DURATION=11
WYR_VOICE_PADDING_SECONDS=1.5
WYR_MAX_IMAGE_SEARCH_RETRIES=2
WYR_REQUEST_TIMEOUT_MS=20000
WYR_TTS_TIMEOUT_MS=60000
WYR_EDGE_VOICE=en-US-AriaNeural
WYR_EDGE_VOICE_RATE=+0%

# Optional executable/font overrides. Relative paths resolve from this project.
# FFMPEG_PATH=
# FFPROBE_PATH=
# WYR_FONT_PATH=assets/fonts/FreeSansBold.ttf
