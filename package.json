{
  "name": "wyr-video-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone autonomous Would You Rather vertical video generator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node wyr-server.js",
    "generate": "node scripts/generate-wyr.mjs",
    "fixture": "node scripts/render-wyr-fixture.mjs --fixture",
    "test": "node --test src/wyr/*.test.js"
  },
  "dependencies": {
    "@seepine/edge-tts": "^1.4.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "overrides": {
    "@seepine/edge-tts": {
      "ws": "8.21.1"
    }
  }
}
